  },
  "labels": ["added", "ambiguous", "contradiction", "modified", "removed", "unchanged"],
  "output_contract": "Exactly one complete JSON object with one key label and a canonical lowercase label string; duplicate keys, extra fields, Markdown, trailing text, aliases, and repair are invalid.",
  "generation": {
    "mode": "greedy_no_sampling",
    "max_new_tokens": 32,
    "assistant_prefix": "empty",
    "grammar_or_json_mode": false,
    "retry_or_repair": false,
    "batch_size": 1,
    "execution_order": "development CSV row order",
    "model_chat_template": "record exact tokenizer and template in pre-run manifest",
    "model_identity": "freeze exact weights and tokenizer hashes before execution"
  },
  "repeatability": {
    "selection_seed": "label-only-600-repeat-v1",
    "selection": "first five SHA-256-ranked case IDs within each reviewed class",
    "cases": 30,
    "additional_passes": 1,
    "required_valid": 30,
    "required_label_agreement": 30,
    "raw_string_agreement": "report but not a gate"
  },
  "metric_conventions": {
    "primary_pass_only": true,
    "invalid_counts_as_wrong": true,
    "macro_f1": "unweighted mean of all six class F1 values; zero denominator yields zero",
    "confusion_columns": ["added", "ambiguous", "contradiction", "modified", "removed", "unchanged", "INVALID"]
  },
  "prerequisites": {
    "primary_structurally_valid": 150,
    "repeat_subset_structurally_valid": 30,
    "repeat_subset_label_agreement": 30,
    "identity_and_protocol_hashes_match": true,
    "complete_raw_evidence": true
  },
  "decision_order": ["INCONCLUSIVE_ON_PREREQUISITE", "TRAINING_EXPERIMENT_JUSTIFIED", "NO_TRAINING_JUSTIFIED", "INCONCLUSIVE_GRAY_ZONE"],
  "training_experiment_justified_if_any": {

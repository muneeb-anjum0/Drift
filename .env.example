# Local Docker Compose configuration. Copy to .env; never commit real secrets.
# Required: generate two different random values of at least 32 characters.
JWT_SECRET=
DRIFT_INFERENCE_API_KEY=
# Optional for local-only mode; required for external provider credentials.
# Generate an independent key with: openssl rand -base64 32
DRIFT_PROVIDER_MASTER_KEY=

# Optional local settings. The UI and core API work without model weights.
COMPOSE_PROJECT_NAME=drift
DRIFT_FRONTEND_PORT=5173
DRIFT_BACKEND_PORT=5000
JWT_EXPIRES_IN_HOURS=168
AUTH_RATE_LIMIT_REQUESTS=10
INFERENCE_RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
DRIFT_INFERENCE_TIMEOUT_MS=65000
DRIFT_RELEVANCE_THRESHOLD=0.25
DRIFT_MAX_ANALYZED_REQUIREMENTS=3
FIREBASE_STORAGE_ENABLED=false
MAX_UPLOAD_SIZE_MB=10

# Optional original GGUF. Put the 4.36 GiB file at the path below, verify its
# documented SHA-256, then start the model profile separately.
DRIFT_GGUF_MODEL_PATH=/app/models/gguf/DriftLedger-Qwen2.5-7B-Q4_K_M.gguf
DRIFT_LLAMA_CTX_SIZE=768
DRIFT_LLAMA_GPU_LAYERS=0
DRIFT_LLAMA_THREADS=6
DRIFT_LLAMA_PARALLEL=1
DRIFT_LLAMA_MAX_TOKENS=120
DRIFT_GPU_LAYERS=16

# Advanced: separate local storage integration. Keep disabled for first use.
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

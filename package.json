{
  "name": "driftledger",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "npm run dev:go",
    "dev:go": "concurrently -n client,server-go -c cyan,green \"npm run dev --workspace client\" \"cd server-go && go run ./cmd/api\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev:server-go",
    "dev:server-go": "cd server-go && go run ./cmd/api",
    "build": "npm run build --workspace client",
    "build:client": "npm run build --workspace client",
    "build:server": "cd server-go && go test ./...",
    "typecheck": "npm run typecheck --workspace client",
    "lint": "npm run lint --workspace client",
    "test:server": "cd server-go && go test ./...",
    "test:inference": "python3 -m pytest services/inference/test_app.py",
    "test:integration": "cd server-go && go test -count=1 ./internal/integration",
    "test:e2e": "npm run test:e2e --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

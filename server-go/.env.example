PORT=5000
APP_ENV=development
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=driftledger
# Required: use independent random values with at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=168
AUTH_RATE_LIMIT_REQUESTS=10
INFERENCE_RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
CLIENT_URL=http://localhost:5173

DRIFT_INFERENCE_ENABLED=true
DRIFT_INFERENCE_URL=http://localhost:8000
DRIFT_INFERENCE_API_KEY=
DRIFT_INFERENCE_TIMEOUT_MS=65000
DRIFT_RELEVANCE_THRESHOLD=0.25
DRIFT_MAX_ANALYZED_REQUIREMENTS=3

FIREBASE_STORAGE_ENABLED=false
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
MAX_UPLOAD_SIZE_MB=10

# Copy to .env.staging (ignored). Use synthetic data only for the first staging run.
# This example cannot start the stack: required secrets and model source are blank.
# A TLS terminator must own the public staging origin; Compose binds HTTP to loopback.
STAGING_CLIENT_ORIGIN=https://staging.example.invalid
STAGING_HTTP_PORT=5174
STAGING_RELEASE_ID=
STAGING_NETWORK_SUBNET=172.30.41.0/24
# Existing services use explicit, unique IPs; the later external TLS ingress
# must attach at the distinct proxy IP. Change all values together if the
# subnet collides with the target host/VPN. Do NOT use Docker aux_addresses:
# that reserves the proxy IP and prevents the ingress from attaching.
STAGING_DB_IP=172.30.41.2
STAGING_LLAMA_IP=172.30.41.3
STAGING_INFERENCE_IP=172.30.41.4
STAGING_BACKEND_IP=172.30.41.5
STAGING_FRONTEND_IP=172.30.41.6
STAGING_TLS_PROXY_IP=172.30.41.11

# Independent secrets, never production values. Mongo password must be URL-safe
# (unreserved URI characters) because the local-only URI is assembled in Compose.
STAGING_JWT_SECRET=
STAGING_INFERENCE_API_KEY=
STAGING_MONGO_USER=drift_staging_admin
STAGING_MONGO_PASSWORD=

# Absolute path to a dedicated, verified copy of the ORIGINAL production GGUF.
# Do not point at the rejected Phase III-J candidate or a shared writable directory.
STAGING_ORIGINAL_GGUF=

# Explicit staging-only controls; do not inherit local .env or production values.
STAGING_JWT_EXPIRES_IN_HOURS=24
STAGING_AUTH_RATE_LIMIT_REQUESTS=10
STAGING_INFERENCE_RATE_LIMIT_REQUESTS=20
STAGING_RATE_LIMIT_WINDOW_SECONDS=60
STAGING_INFERENCE_TIMEOUT_MS=65000
STAGING_MAX_UPLOAD_SIZE_MB=10

# Initial staging has no uploaded-file storage. Enable GCS only after separate
# staging bucket, credentials, retention, and backup/restore have been reviewed.
STAGING_FIREBASE_STORAGE_ENABLED=false
STAGING_FIREBASE_STORAGE_BUCKET=
STAGING_GOOGLE_APPLICATION_CREDENTIALS=
